{
  "name": "tribox-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run -s check:sync-copy && npm run -s check:m0-web-legal && npm run -s check:account-boundary && next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "check:m0-web-legal": "node scripts/check-m0-web-legal.mjs",
    "check:sync-copy": "node scripts/check-sync-copy.mjs",
    "check:account-boundary": "node scripts/check-account-boundary.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "next-intl": "^4.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.1",
    "typescript": "5"
  }
}
